# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxx

# Claude model for the chat agents (dashboard). Pipeline uses Sonnet 5 + Opus 4.8.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Hugo — Lead Intelligence Pipeline research engines (optional) ───────────
# The 8-source deep-research stack. Leave empty to run on the already-scored
# universe in the DB; fill in to enable live pipeline re-runs (TPDL provides).
EXA_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_KEY=
SERPER_API_KEY=              # target SERP engine (cheaper); used instead of SerpAPI when set
APIFY_TOKEN=
FIRECRAWL_API_KEY=           # IR / website page fetch (conditional)
# EU company registries: FREE public-web source (uses the SERP engine above).
# Set to 1 to enable — off by default so it doesn't consume SERP quota per run.
EU_REGISTRY_ENABLED=
# 9th source (opt-in, CLI --social-scan): Twitter/Reddit/LinkedIn jobs/Instagram/
# YouTube via agent-reach's CLIs (opencli + yt-dlp). No API key — needs those CLIs
# installed + logged into the target platforms in Chrome. Off by default: it's
# browser automation (slow, rate-limited per platform), not an HTTP API.
SOCIAL_SCAN_ENABLED=

# ── Inès — decision-maker contacts + email verification ────────────────────
APOLLO_API_KEY=              # current contact engine
KASPR_API_KEY=               # target contact engine (better CH/ES coverage); used instead of Apollo when set
BOUNCER_API_KEY=             # email deliverability check — run before any send (usebouncer.com)

# ── Julie — Lemlist (multichannel outreach sequences) ──────────────────────
LEMLIST_API_KEY=             # enrol approved+verified leads into email/LinkedIn sequences (outbound)

# Server port (default: 8000)
PORT=8000

# Database URL. Local dev: SQLite (default). Prod (Azure App Service, multi-user):
# Postgres, e.g. postgresql+psycopg://USER:PASS@HOST:5432/tpdl?sslmode=require
DATABASE_URL=sqlite:///./data/app.db

# ── Shared-app auth (turn ON in prod so the team logs in) ──
# TPDL_AUTH_GATE=on            # off (default) = public demo; on = team login required
# TPDL_TEAM_PASSWORD=          # 🔴 a real password in prod (never leave the default)

# Where the app writes data files (SQLite DB, brand_memory.json).
# In prod (Railway), set to the mounted volume, e.g. /data
DATA_DIR=./data

# Session secret for login cookies (use a long random string in prod).
# If unset, a secret is generated and persisted to DATA_DIR/.session_secret.
TPDL_SESSION_SECRET=change-me-to-a-long-random-string

# Set true in production (HTTPS) so session cookies never travel over HTTP
SESSION_HTTPS_ONLY=false

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (optional) — leave empty to run on local SQLite.
# When URL + SERVICE_KEY are set, the app uses Supabase (Postgres + realtime).
#   • Settings -> API -> Project URL          -> SUPABASE_URL
#   • Settings -> API -> anon public key      -> SUPABASE_ANON_KEY   (public)
#   • Settings -> API -> service_role secret  -> SUPABASE_SERVICE_KEY (SECRET)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
